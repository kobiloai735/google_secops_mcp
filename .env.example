# Google SecOps MCP Server — Environment Variables
# Copy this file to .env and fill in your values.

# GCP Project ID linked to the SecOps tenant
SECOPS_PROJECT_ID=your-gcp-project-id

# SecOps Instance / Customer ID (GUID)
# Find it at: Settings → SIEM Settings → Tenant Information
SECOPS_INSTANCE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# API region — "us" for backstory.chronicle.security tenants
SECOPS_REGION=us

# Optional: path to a service account JSON key file.
# If omitted, Application Default Credentials (ADC) are used.
# Set up ADC with: gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\service_account.json
